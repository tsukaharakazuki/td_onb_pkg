timezone: "Asia/Tokyo"

_export:
  !include : 'config/params.yml'
  # 123FormBuilder API設定
  formbuilder:
    username: ${secret:formbuilder_username}
    password: ${secret:formbuilder_password}

#schedule:
#  daily>: 02:30:00

+start:
  echo>: "Starting 123FormBuilder groups data extraction..."

# 取り込み先テーブルを事前に作成（既に存在する場合は何もしない）
+create_table:
  td_ddl>:
  create_tables: [formbuilder_groups]
  database: ${td.database}

+extract_groups:
  py>: pyscript.groups_fetcher.main
  docker:
    image: "treasuredata/customscript-python:3.12.11-td4"
  _env:
    FORMBUILDER_USERNAME: ${formbuilder.username}
    FORMBUILDER_PASSWORD: ${formbuilder.password}
    TD_API_KEY: ${secret:td.apikey}
    TD_DATABASE: ${td.database}

+store_groups:
  echo>: "Groups data has been output by the Python script and stored in TD"

+cleanup:
  echo>: "123FormBuilder groups data extraction completed successfully"

_error:
  echo>: "123FormBuilder groups data extraction failed. Workflow: ${session_id}, Time: ${session_time}"

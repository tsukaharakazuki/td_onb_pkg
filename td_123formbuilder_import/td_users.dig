timezone: Asia/Tokyo

_export:
  !include : config/params.yml

#schedule:
#  daily>: "03:00:00"

+create_table:
  td_ddl>:
  create_tables: [formbuilder_users]
  database: ${td.database}

+extract_users:
  py>: pyscript.users_fetcher.main
  docker:
    image: "treasuredata/customscript-python:3.12.11-td4"
  _env:
    FORMBUILDER_USERNAME: ${secret:formbuilder_username}
    FORMBUILDER_PASSWORD: ${secret:formbuilder_password}
    FORMBUILDER_BASE_URL: ${formbuilder_base_url}
    TD_API_KEY: ${secret:td.apikey}
    TD_DATABASE: ${td.database}
    TD_API_SERVER: ${td_api_server}

_error:
  echo>: "IMPORT_FAILED. Check +extract_users logs. Session ${session_id}"

# =====================================================================
# 初回セットアップ（最初に1回だけ手動実行）
# ---------------------------------------------------------------------
# - 出力DB・テーブルを作成（config/common.yml の output_db など）
# - 休眠ユーザー判定用の履歴を、過去の監査ログから初期投入
# 何度実行しても安全です
# =====================================================================
timezone: Asia/Tokyo

_export:
  !include : 'config/common.yml'
  !include : 'config/emergency_rules.yml'
  run_env: prod
  table_suffix: ""

+setup:
  call>: sub_setup.dig

# =====================================================================
# モード2: 要注意ログ 日次レポート（1日1回）
# ---------------------------------------------------------------------
# 緊急性は高くないが確認すべき操作・ユーザーを、過去24時間分まとめて報告します
# 検知ルールは config/caution_rules.yml で追加・変更できます
#
# 出力テーブルが無い場合は、最初に自動でセットアップします（setup_tables.dig の手動実行は不要）
# スケジュールは既定で有効です。止めたい場合は schedule をコメントアウトして push してください
# =====================================================================
timezone: Asia/Tokyo

schedule:
  daily>: 09:00:00

_export:
  !include : 'config/common.yml'
  !include : 'config/notification.yml'
  !include : 'config/caution_rules.yml'
  # emergency_rules.yml は自動セットアップ（休眠ユーザー判定用の履歴の初期投入）で使用
  !include : 'config/emergency_rules.yml'
  run_env: prod
  table_suffix: ""

+ensure_setup:
  call>: sub_ensure_setup.dig

+caution:
  call>: sub_caution.dig

# =====================================================================
# モード1: 緊急情報漏洩チェック（10分ごと）
# ---------------------------------------------------------------------
# - ホワイトリスト外IPからのアクセス
# - 休眠ユーザーがログインせずに重要操作
# - AI・自動化ツールによる探索とみられる挙動
# を検知し、メール（＋設定したチャット）に通知します
#
# 出力テーブルが無い場合は、最初に自動でセットアップします（setup_tables.dig の手動実行は不要）
# スケジュールは既定で有効です。止めたい場合は schedule をコメントアウトして push してください
# =====================================================================
timezone: Asia/Tokyo

schedule:
  minutes_interval>: 10

_export:
  !include : 'config/common.yml'
  !include : 'config/notification.yml'
  !include : 'config/ip_whitelist.yml'
  !include : 'config/emergency_rules.yml'
  run_env: prod
  table_suffix: ""

+ensure_setup:
  call>: sub_ensure_setup.dig

+emergency:
  call>: sub_emergency.dig
